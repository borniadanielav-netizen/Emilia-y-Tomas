      musicTimer = setInterval(() => {
        if (!musicPlaying) return;
        playSoftNote(notes[noteIndex % notes.length], audioContext.currentTime);
        noteIndex++;
      }, 850);
      playSoftNote(notes[0], audioContext.currentTime);
    }
    function stopMusic() {
